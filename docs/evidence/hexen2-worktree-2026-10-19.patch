+/**
+ * @module engine/client/hexen2_pixel_menu
+ *
+ * Draws the pause menu on Quaked's existing 320×200 overlay canvas with the native Hexen II small font and palette
+ * fills. The model stays in `hexen2_menu.js`; this module is presentation only, so the same keyboard model is shared by
+ * the DOM test host and the in-game pixel screen.
+ *
+ * Types: plain values and functions; no exported classes.
+ * State: no mutable exports.
+ * Errors: none; a closed menu or absent overlay draws nothing.
+ */
+
+import { Draw_GetOverlayCanvas, Draw_SmallString } from '../render/gl_draw.js';
+import { Hexen2_MenuItems, Hexen2_MenuLines } from './hexen2_menu.js';
+
+const LEFT = 16, WIDTH = 288;
+
+function clipped( text, max = 46 ) { return String( text ).length > max ? String( text ).slice( 0, max - 1 ) + '…' : String( text ); }
+
+function fill( x, y, width, height, style, alpha ) {
+
+	const ctx = Draw_GetOverlayCanvas()?.getContext( '2d' );
+	if ( !ctx ) return;
+	ctx.save();
+	ctx.globalAlpha = alpha;
+	ctx.fillStyle = style;
+	ctx.fillRect( x, y, width, height );
+	ctx.restore();
+
+}
+
+/**
+ * Draws the open menu over the native status bar.
+ *
+ * @param {{ isOpen: function(): boolean, state: function(): object }} menu the menu host
+ * @returns {boolean} whether anything was drawn
+ */
+export function Hexen2_DrawPixelMenu( menu ) {
+
+	if ( !menu?.isOpen?.() ) return false;
+	const model = menu.state?.();
+	if ( !model ) return false;
+	const items = Hexen2_MenuItems( model.panel, model.values );
+	const lines = Hexen2_MenuLines( model.panel, model.hud, model.values );
+	const listTop = model.panel === 'main' ? 56 : Math.min( 44 + lines.length * 10, 118 );
+	const height = Math.max( 78, listTop + items.length * 13 + 18 );
+	fill( 0, 0, 320, 200, '#050508', 0.86 );
+	fill( 12, 8, 296, height, '#0d0b09', 0.9 );
+	fill( 12, 8, 296, 1, '#8a744a', 0.9 );
+	fill( 12, 8 + height, 296, 1, '#8a744a', 0.9 );
+	Draw_SmallString( LEFT, 14, clipped( model.panel === 'main' ? 'HEXEN II - PAUSED' : model.panel.toUpperCase() ) );
+	Draw_SmallString( LEFT, 26, model.panel === 'main' ? 'Esc resumes. Arrows move. Enter selects.' : 'Esc back. Arrows move.' );
+	for ( let i = 0; i < lines.length; i ++ ) Draw_SmallString( LEFT, 40 + i * 10, clipped( lines[ i ], 47 ) );
+	items.forEach( ( item, i ) => {
+
+		const y = listTop + i * 13;
+		if ( i === model.index ) fill( 14, y - 2, 286, 11, '#6d5a34', 0.55 );
+		Draw_SmallString( LEFT, y, clipped( ( i === model.index ? '> ' : '  ' ) + item.label + ( item.value !== undefined ? ' : ' + item.value : '' ) ) );
+
+	} );
+	Draw_SmallString( LEFT, 186, 'HEXEN II' );
+	return true;
+
+}
diff --git a/src/engine/common/hexen2_hub.js b/src/engine/common/hexen2_hub.js
new file mode 100644
index 00000000..05cd5bb3
--- /dev/null
+++ b/src/engine/common/hexen2_hub.js
@@ -0,0 +1,113 @@
+/**
+ * @module engine/common/hexen2_hub
+ *
+ * Whole-hub world snapshots for the local Hexen II page: the save-file edict/global text that Quake already uses
+ * (`ED_Write`/`ED_WriteGlobals`, `ED_ParseEdict`/`ED_ParseGlobals`), captured per visited level. This is the same
+ * serialization surface as the Quake save path, not a second world format; the page stores the text with the level's
+ * player snapshot so a revisited hub level restores its doors, monsters, items and trigger state.
+ *
+ * Types: plain values and functions; no exported classes.
+ * State: no mutable exports.
+ * Errors: capture/restore return `{ ok, reason }` for malformed records; parsing errors propagate from the existing
+ *   ED parser (a corrupt save is refused by the caller).
+ */
+
+import { COM_Parse } from './common.js';
+import { ED_Write, ED_WriteGlobals, ED_ParseGlobals, ED_ParseEdict, ED_Alloc } from '../progs/pr_edict.js';
+import { EDICT_NUM } from '../progs/progs.js';
+import { SV_LinkEdict } from '../server/world.js';
+
+/** The snapshot schema version. */
+export const HEXEN2_WORLD_SCHEMA = 1;
+
+/**
+ * Captures the live server's world: light styles, save globals and every edict in the existing ED text form.
+ *
+ * @param {object} sv the live server state
+ * @returns {{ schema: number, level: string, time: number, lightstyles: Array<?string>, lines: string[] }} the snapshot
+ */
+export function Hexen2_CaptureWorld( sv ) {
+
+	const lines = [];
+	ED_WriteGlobals( lines );
+	for ( let i = 0; i < sv.num_edicts; i ++ ) ED_Write( lines, EDICT_NUM( i ) );
+	return Object.freeze( {
+		schema: HEXEN2_WORLD_SCHEMA,
+		level: String( sv.name ?? sv.worldmodel?.name ?? '' ),
+		time: Number( sv.time ) || 0,
+		lightstyles: ( sv.lightstyles ?? [] ).map( value => value ?? null ),
+		lines: Object.freeze( lines )
+	} );
+
+}
+
+/**
+ * Checks a world snapshot's shape.
+ *
+ * @param {?object} snapshot the candidate
+ * @returns {{ ok: true } | { ok: false, reason: string }} the check
+ */
+export function Hexen2_ValidateWorld( snapshot ) {
+
+	if ( snapshot === null || typeof snapshot !== 'object' ) return { ok: false, reason: 'no world snapshot' };
+	if ( snapshot.schema !== HEXEN2_WORLD_SCHEMA ) return { ok: false, reason: `unsupported world schema ${String( snapshot.schema )}` };
+	if ( typeof snapshot.level !== 'string' || snapshot.level === '' ) return { ok: false, reason: 'the world has no level' };
+	if ( !Array.isArray( snapshot.lines ) || snapshot.lines.length < 2 ) return { ok: false, reason: 'the world has no globals/edicts' };
+	if ( !Array.isArray( snapshot.lightstyles ) ) return { ok: false, reason: 'the world has no light styles' };
+	if ( !Number.isFinite( snapshot.time ) ) return { ok: false, reason: 'the world time is not finite' };
+	return { ok: true };
+
+}
+
+/**
+ * Restores a snapshot into a freshly spawned server. Blocks are the save-file brace form: the first is globals, then
+ * one per edict. The server's edict array is extended when needed and reduced to the snapshot's count; edicts are
+ * relinked into the BSP tree.
+ *
+ * @param {object} sv the live server state
+ * @param {object} snapshot a validated world snapshot
+ * @returns {{ ok: true, count: number } | { ok: false, reason: string }} the result
+ */
+export function Hexen2_RestoreWorld( sv, snapshot ) {
+
+	const valid = Hexen2_ValidateWorld( snapshot );
+	if ( !valid.ok ) return valid;
+	let remaining = snapshot.lines.join( '\n' ), entnum = - 1;
+	while ( remaining.length > 0 ) {
+
+		const start = remaining.indexOf( '{' );
+		if ( start < 0 ) break;
+		const end = remaining.indexOf( '}', start );
+		if ( end < 0 ) return { ok: false, reason: 'a world block has no close' };
+		const block = remaining.slice( start, end + 1 );
+		remaining = remaining.slice( end + 1 );
+		const afterBrace = COM_Parse( block );
+		if ( entnum === - 1 ) {
+
+			ED_ParseGlobals( afterBrace );
+
+		} else {
+
+			while ( sv.num_edicts <= entnum ) ED_Alloc();
+			const ent = EDICT_NUM( entnum );
+			ent.free = false;
+			if ( block.replace( /[{}\s]/g, '' ) === '' ) ent.free = true;
+			else {
+
+				ED_ParseEdict( afterBrace, ent );
+				if ( !ent.free && entnum !== 0 ) SV_LinkEdict( ent, false );
+
+			}
+
+		}
+		entnum ++;
+
+	}
+	if ( entnum < 1 ) return { ok: false, reason: 'the world has no entities' };
+	sv.num_edicts = entnum;
+	sv.name = snapshot.level;
+	sv.time = snapshot.time;
+	sv.lightstyles = snapshot.lightstyles.slice();
+	return { ok: true, count: entnum };
+
+}
diff --git a/src/engine/common/hexen2_save.js b/src/engine/common/hexen2_save.js
new file mode 100644
index 00000000..4de30398
--- /dev/null
+++ b/src/engine/common/hexen2_save.js
@@ -0,0 +1,273 @@
+/**
+ * @module engine/common/hexen2_save
+ *
+ * The first version of Hexen II's save record: a self-describing, validated single-player snapshot of the player's
+ * native fields, the current level and the run identity. It is deliberately a *record and store* boundary, not a hub
+ * serializer: the later whole-hub bundle adds visited-level snapshots and non-edict effects without changing this
+ * shape (the version field is the seam).
+ *
+ * Types: plain values and functions; no exported classes.
+ * State: no mutable exports; `Hexen2_SaveStore` returns a store object with its own IndexedDB/localStorage state.
+ * Errors: validation returns `{ ok: false, reason }`; store failures reject with an Error.
+ */
+
+/** The schema version of this single-session record. */
+export const HEXEN2_SAVE_SCHEMA = 2;
+
+/** Schema 1 records (player only) remain readable; schema 2 adds the visited-level hub. */
+const HEXEN2_SAVE_SCHEMAS = Object.freeze( [ 1, 2 ] );
+
+/** The player fields the record preserves (numeric scalars, in the native field namespace). */
+export const HEXEN2_SAVE_PLAYER_FIELDS = Object.freeze( [
+	'health', 'max_health', 'bluemana', 'greenmana', 'max_mana', 'level', 'experience',
+	'strength', 'intelligence', 'wisdom', 'dexterity',
+	'armor_amulet', 'armor_bracer', 'armor_breastplate', 'armor_helmet',
+	'items', 'weapon', 'current_weapon', 'weaponframe', 'rings_active',
+	'artifacts', 'artifact_active', 'inventory',
+	'cnt_torch', 'cnt_h_boost', 'cnt_sh_boost', 'cnt_mana_boost', 'cnt_teleport', 'cnt_tome', 'cnt_summon',
+	'cnt_invisibility', 'cnt_glyph', 'cnt_haste', 'cnt_blast', 'cnt_polymorph', 'cnt_flight', 'cnt_cubeofforce',
+	'cnt_invincibility', 'ring_flight', 'ring_water', 'ring_turning', 'ring_regeneration',
+	'puzzle_inv1', 'puzzle_inv2', 'puzzle_inv3', 'puzzle_inv4', 'puzzle_inv5', 'puzzle_inv6', 'puzzle_inv7', 'puzzle_inv8'
+] );
+
+const VECTORS = Object.freeze( [ 'origin', 'angles', 'velocity', 'v_angle' ] );
+const finite = value => typeof value === 'number' && Number.isFinite( value );
+
+/**
+ * Copies the restorable player state out of a native player edict.
+ *
+ * @param {?object} player the player edict (`player.v` is the native field object)
+ * @returns {{ fields: object, vectors: object }} scalars and the four vectors
+ */
+export function Hexen2_CapturePlayer( player ) {
+
+	const v = player?.v ?? {};
+	const fields = {}, vectors = {};
+	for ( const name of HEXEN2_SAVE_PLAYER_FIELDS ) fields[ name ] = finite( v[ name ] ) ? v[ name ] : 0;
+	for ( const name of VECTORS ) vectors[ name ] = [ finite( v[ name ]?.[ 0 ] ) ? v[ name ][ 0 ] : 0,
+		finite( v[ name ]?.[ 1 ] ) ? v[ name ][ 1 ] : 0, finite( v[ name ]?.[ 2 ] ) ? v[ name ][ 2 ] : 0 ];
+	return { fields, vectors };
+
+}
+
+/**
+ * Builds the version-1 record.
+ *
+ * @param {{ gameId: string, classId: string, skill: number, level: string, player: object, time?: number }} options
+ *   the run identity and the live player
+ * @returns {object} the save record
+ */
+export function Hexen2_BuildSaveBundle( options ) {
+
+	const captured = Hexen2_CapturePlayer( options.player );
+	const hub = options.hub && typeof options.hub === 'object' ? Object.freeze( { levels: options.hub.levels ?? {}, worlds: options.hub.worlds ?? {} } ) : undefined;
+	const view = options.view && typeof options.view === 'object' ? Object.freeze( {
+		angles: Object.freeze( [ 0, 1, 2 ].map( i => finite( options.view.angles?.[ i ] ) ? options.view.angles[ i ] : 0 ) ),
+		time: finite( options.view.time ) ? options.view.time : 0
+	} ) : undefined;
+	return Object.freeze( {
+		schema: HEXEN2_SAVE_SCHEMA,
+		kind: 'hexen2-single-session',
+		savedAt: new Date().toISOString(),
+		identity: Object.freeze( { gameId: String( options.gameId ?? 'hexen2' ), classId: String( options.classId ?? 'paladin' ),
+			skill: Number.isInteger( options.skill ) ? options.skill : 1, level: String( options.level ?? 'demo1' ) } ),
+		time: finite( options.time ) ? options.time : 0,
+		player: Object.freeze( captured.fields ),
+		vectors: Object.freeze( Object.fromEntries( Object.entries( captured.vectors ).map( ( [ k, v ] ) => [ k, Object.freeze( v ) ] ) ) ),
+		...( hub ? { hub } : {} ),
+		...( view ? { view } : {} )
+	} );
+
+}
+
+/**
+ * Checks the record's shape and ranges before any live field is written.
+ *
+ * @param {?object} bundle the candidate
+ * @returns {{ ok: true } | { ok: false, reason: string }} the check
+ */
+export function Hexen2_ValidateSaveBundle( bundle ) {
+
+	if ( bundle === null || typeof bundle !== 'object' ) return { ok: false, reason: 'no save record' };
+	if ( !HEXEN2_SAVE_SCHEMAS.includes( bundle.schema ) ) return { ok: false, reason: `unsupported save schema ${String( bundle.schema )}` };
+	if ( bundle.kind !== 'hexen2-single-session' ) return { ok: false, reason: 'not a Hexen II single-session record' };
+	if ( !bundle.identity || typeof bundle.identity.level !== 'string' || bundle.identity.level === '' ) return { ok: false, reason: 'the record has no level' };
+	if ( typeof bundle.identity.gameId !== 'string' || typeof bundle.identity.classId !== 'string' ) return { ok: false, reason: 'the record has no run identity' };
+	if ( !Number.isInteger( bundle.identity.skill ) || bundle.identity.skill < 0 || bundle.identity.skill > 3 ) return { ok: false, reason: 'the record skill is out of range' };
+	if ( bundle.player === null || typeof bundle.player !== 'object' ) return { ok: false, reason: 'the record has no player fields' };
+	for ( const name of HEXEN2_SAVE_PLAYER_FIELDS ) if ( !finite( bundle.player[ name ] ) ) return { ok: false, reason: `player field ${name} is not finite` };
+	for ( const name of VECTORS ) {
+
+		const v = bundle.vectors?.[ name ];
+		if ( !Array.isArray( v ) || v.length !== 3 || !v.every( finite ) ) return { ok: false, reason: `player vector ${name} is invalid` };
+
+	}
+	if ( finite( bundle.time ) === false ) return { ok: false, reason: 'the record time is not finite' };
+	if ( bundle.view !== undefined ) {
+
+		if ( bundle.view === null || typeof bundle.view !== 'object' || !Array.isArray( bundle.view.angles ) || bundle.view.angles.length !== 3 || !bundle.view.angles.every( finite ) || !finite( bundle.view.time ) )
+			return { ok: false, reason: 'the record view is malformed' };
+
+	}
+	if ( bundle.hub !== undefined ) {
+
+		if ( bundle.hub === null || typeof bundle.hub !== 'object' || bundle.hub.levels === null || typeof bundle.hub.levels !== 'object' || bundle.hub.worlds === null || typeof bundle.hub.worlds !== 'object' )
+			return { ok: false, reason: 'the record hub is malformed' };
+
+	}
+	return { ok: true };
+
+}
+
+/**
+ * Writes a validated record onto a live player. The caller reloads the named level first when it differs; this
+ * function never changes the level.
+ *
+ * @param {object} bundle a validated record
+ * @param {object} player the live player edict
+ * @param {{ vectors?: boolean }} [options] whether to restore origin/angles/velocity (false for a level transition,
+ *   where the new map's start must win)
+ * @returns {{ ok: true } | { ok: false, reason: string }} the result
+ */
+export function Hexen2_ApplySaveBundle( bundle, player, options = {} ) {
+
+	const valid = Hexen2_ValidateSaveBundle( bundle );
+	if ( !valid.ok ) return valid;
+	if ( !player?.v ) return { ok: false, reason: 'no live player' };
+	for ( const name of HEXEN2_SAVE_PLAYER_FIELDS ) player.v[ name ] = bundle.player[ name ];
+	if ( options.vectors !== false ) for ( const name of VECTORS ) player.v[ name ] = [ bundle.vectors[ name ][ 0 ], bundle.vectors[ name ][ 1 ], bundle.vectors[ name ][ 2 ] ];
+	return { ok: true };
+
+}
+
+function memoryStore() {
+
+	const items = new Map();
+	return { async put( key, value ) { items.set( key, JSON.parse( JSON.stringify( value ) ) ); }, async get( key ) { return items.get( key ) ?? null; },
+		async list() { return [ ...items.keys() ]; }, async remove( key ) { items.delete( key ); }, kind: 'memory' };
+
+}
+
+/**
+ * The persistence boundary. IndexedDB stores the record in one object store with a single put (a failed put leaves the
+ * previous value); without IndexedDB the browser's localStorage keeps the JSON record, and without storage an in-memory
+ * store is returned so the UI can still report a non-persistent save.
+ *
+ * @param {{ indexedDB?: object, localStorage?: object, name?: string }} [env] the platform objects (defaults to the globals)
+ * @returns {{ put: function(string, object): Promise<void>, get: function(string): Promise<?object>,
+ *   list: function(): Promise<Array<string>>, remove: function(string): Promise<void>, kind: string }} the store
+ */
+export function Hexen2_SaveStore( env = {} ) {
+
+	const factory = env.indexedDB ?? globalThis.indexedDB;
+	if ( factory && typeof factory.open === 'function' ) {
+
+		const dbName = env.name ?? 'quaked-hexen2-saves', storeName = 'saves';
+		let opening = null;
+		const open = () => opening ??= new Promise( ( resolve, reject ) => {
+
+			const request = factory.open( dbName, 1 );
+			request.onupgradeneeded = () => { if ( !request.result.objectStoreNames.contains( storeName ) ) request.result.createObjectStore( storeName ); };
+			request.onsuccess = () => resolve( request.result );
+			request.onerror = () => reject( request.error ?? new Error( 'IndexedDB open failed' ) );
+
+		} );
+		const run = async ( mode, action ) => {
+
+			const db = await open();
+			return new Promise( ( resolve, reject ) => {
+
+				const tx = db.transaction( storeName, mode ), store = tx.objectStore( storeName );
+				const request = action( store );
+				request.onsuccess = () => resolve( request.result );
+				request.onerror = () => reject( request.error ?? new Error( 'IndexedDB request failed' ) );
+				tx.onabort = () => reject( tx.error ?? new Error( 'IndexedDB transaction aborted' ) );
+
+			} );
+
+		};
+		return { kind: 'indexeddb', async put( key, value ) { await run( 'readwrite', store => store.put( value, key ) ); },
+			async get( key ) { return ( await run( 'readonly', store => store.get( key ) ) ) ?? null; },
+			async list() { return ( await run( 'readonly', store => store.getAllKeys() ) ) ?? []; },
+			async remove( key ) { await run( 'readwrite', store => store.delete( key ) ); } };
+
+	}
+	const storage = env.localStorage ?? ( () => { try { return globalThis.localStorage ?? null; } catch { return null; } } )();
+	if ( storage ) return { kind: 'localstorage',
+		async put( key, value ) { storage.setItem( 'quaked.hexen2.save.' + key, JSON.stringify( value ) ); },
+		async get( key ) { const raw = storage.getItem( 'quaked.hexen2.save.' + key ); return raw ? JSON.parse( raw ) : null; },
+		async list() { const out = [], prefix = 'quaked.hexen2.save.'; for ( let i = 0; i < storage.length; i ++ ) { const key = storage.key( i ); if ( key?.startsWith( prefix ) ) out.push( key.slice( prefix.length ) ); } return out; },
+		async remove( key ) { storage.removeItem( 'quaked.hexen2.save.' + key ); } };
+	return memoryStore();
+
+}
+
+/**
+ * Normalises a Hexen map name from the gamecode/trigger form (`ruins`, `maps/ruins.bsp`) to the mount form
+ * (`maps/ruins.bsp`).
+ *
+ * @param {string} name the map name
+ * @returns {string} the normalised map path, or '' for an empty/invalid name
+ */
+export function Hexen2_NormalizeMapName( name ) {
+
+	const text = String( name ?? '' ).trim().replace( /\\/g, '/' );
+	if ( text === '' ) return '';
+	if ( text.startsWith( 'maps/' ) || text.includes( '/' ) ) return text.endsWith( '.bsp' ) ? text : text + '.bsp';
+	return 'maps/' + ( text.endsWith( '.bsp' ) ? text : text + '.bsp' );
+
+}
+
+/**
+ * Builds the same-page transition URL a changelevel uses. It keeps the game identity, class and skill and asks the
+ * page to autostart the next map instead of reopening the character gate.
+ *
+ * @param {{ pathname?: string, gameId: string, classId: string, skill: number, map: string, spot?: string }} options
+ * @returns {string} the relative URL
+ */
+export function Hexen2_TransitionUrl( options ) {
+
+	const params = new URLSearchParams();
+	params.set( 'game', String( options.gameId ?? 'hexen2' ) );
+	params.set( 'autostart', '1' );
+	params.set( 'class', String( options.classId ?? 'paladin' ) );
+	params.set( 'skill', String( Number.isInteger( options.skill ) ? options.skill : 1 ) );
+	params.set( 'map', Hexen2_NormalizeMapName( options.map ) );
+	if ( options.spot ) params.set( 'spot', String( options.spot ) );
+	return String( options.pathname ?? location.pathname ) + '?' + params.toString();
+
+}
+
+/**
+ * A small whole-hub snapshot store keyed by normalised level name. It is the first step beyond the single-session
+ * record: returning to a visited hub level restores that level's snapshot, while a forward level starts at the map's
+ * own player start. It deliberately does not yet persist cross-level trigger/timer state.
+ *
+ * @param {{ localStorage?: object }} [env] the storage (defaults to the browser localStorage)
+ * @returns {{ put: function(string, object): void, get: function(string): ?object, all: function(): object,
+ *   remove: function(string): void, clear: function(): void, key: string }} the hub store
+ */
+export function Hexen2_HubStore( env = {} ) {
+
+	const storage = env.localStorage ?? ( () => { try { return globalThis.localStorage ?? null; } catch { return null; } } )();
+	const key = 'quaked.hexen2.hub.v1';
+	const read = () => {
+
+		try { const raw = storage?.getItem( key ); const parsed = raw ? JSON.parse( raw ) : null;
+			return parsed && typeof parsed === 'object' && parsed.levels ? { levels: parsed.levels, worlds: parsed.worlds ?? {} } : { levels: {}, worlds: {} }; } catch { return { levels: {}, worlds: {} }; }
+
+	};
+	const write = value => { try { storage?.setItem( key, JSON.stringify( value ) ); } catch { /* quota/private mode: the caller reports the save as non-persistent */ } };
+	return {
+		key,
+		put( level, bundle ) { const value = read(); value.levels[ Hexen2_NormalizeMapName( level ) ] = bundle; write( value ); },
+		get( level ) { return read().levels[ Hexen2_NormalizeMapName( level ) ] ?? null; },
+		all() { return read().levels; },
+		putWorld( level, world ) { const value = read(); value.worlds[ Hexen2_NormalizeMapName( level ) ] = world; write( value ); },
+		getWorld( level ) { return read().worlds[ Hexen2_NormalizeMapName( level ) ] ?? null; },
+		allWorlds() { return read().worlds; },
+		remove( level ) { const value = read(), name = Hexen2_NormalizeMapName( level ); delete value.levels[ name ]; delete value.worlds[ name ]; write( value ); },
+		clear() { write( { levels: {}, worlds: {} } ); }
+	};
+
+}
diff --git a/tests/hexen2_animation_test.js b/tests/hexen2_animation_test.js
new file mode 100644
index 00000000..9b4d35d8
--- /dev/null
+++ b/tests/hexen2_animation_test.js
@@ -0,0 +1,127 @@
+// First-person weapon and enemy animation on demo1 with the supplied gamecode: holding attack advances the native
+// weaponframe (the page renders it on the viewmodel), and a live monster enters an attack state and advances its model
+// frame. Plan sections 5, E05 and E13 prerequisites.
+import { existsSync, readFileSync } from 'node:fs';
+import * as pak from '../src/engine/common/pak.js';
+import { VID_SetPalette } from '../src/engine/render/vid.js';
+import { Mod_Init } from '../src/engine/render/gl_model.js';
+import { model_t } from '../src/engine/render/gl_model_types.js';
+import { set_loadmodel, Mod_FindName } from '../src/engine/render/gl_model_common.js';
+import { Mod_LoadBrushModel, Mod_SetHexenHullLayout } from '../src/engine/render/gl_model_bsp.js';
+import { SV_ClearWorld, SV_LinkEdict, SV_PointContents, SV_TestEntityPosition, SV_Move } from '../src/engine/server/world.js';
+import { SV_SetState, SV_SetFrametime, SV_Physics } from '../src/engine/server/sv_phys.js';
+import { PR_LoadProgs, PR_AllocEdicts, ED_FindFunction } from '../src/engine/progs/pr_edict.js';
+import { PR_SetSV, PR_SetSVS, PR_GetString, pr_global_struct, svs, EDICT_TO_PROG, pr_functions } from '../src/engine/progs/progs.js';
+import { sv as serverSv, ss_loading, ss_active, SIGNON_SIZE } from '../src/engine/server/server.js';
+import { PR_ExecuteProgram, PR_LastRunError } from '../src/engine/progs/pr_exec.js';
+import { Hexen2_SeedPrecache, Hexen2_SpawnEntities, Hexen2_SpawnPlayer } from '../src/engine/progs/hexen2_boot.js';
+import { installServerCallbacks } from './helpers/hexen2_server_setup.mjs';
+import '../src/engine/progs/hexen2_world_cmds.js';
+import '../src/engine/progs/hexen2_precache_cmds.js';
+import '../src/engine/progs/hexen2_server_cmds.js';
+
+const check = ( v, m ) => { if ( ! v ) throw new Error( m ); };
+const HEXEN = '/Users/bri/quaked/Hexen 2/data1';
+
+function boot() {
+
+	if ( ! existsSync( HEXEN + '/pak1.pak' ) ) return null;
+	for ( const name of [ 'pak0.pak', 'pak1.pak' ] ) { const raw = readFileSync( HEXEN + '/' + name ); pak.COM_AddPack( pak.COM_LoadPackFile( 'h2-' + name, raw.buffer.slice( raw.byteOffset, raw.byteOffset + raw.length ) ) ); }
+	const palette = pak.COM_FindFile( 'gfx/palette.lmp' ).data;
+	VID_SetPalette( palette.buffer.slice( palette.byteOffset, palette.byteOffset + palette.byteLength ) );
+	Mod_Init();
+	const progsBytes = readFileSync( HEXEN + '/progs.dat' );
+	PR_LoadProgs( progsBytes.buffer.slice( progsBytes.byteOffset, progsBytes.byteOffset + progsBytes.byteLength ) );
+	Mod_SetHexenHullLayout( true );
+	const map = new model_t(); map.name = 'maps/demo1.bsp'; set_loadmodel( map );
+	const bsp = pak.COM_FindFile( 'maps/demo1.bsp' ).data;
+	Mod_LoadBrushModel( map, bsp.buffer.slice( bsp.byteOffset, bsp.byteOffset + bsp.byteLength ) );
+	Mod_SetHexenHullLayout( false );
+	const sv = serverSv;
+	PR_SetSV( sv ); PR_SetSVS( { maxclients: 1, clients: [], active: true } );
+	sv.time = 0.1; sv.signon.data = sv.signon_buf; sv.signon.maxsize = SIGNON_SIZE; sv.worldmodel = map;
+	Hexen2_SeedPrecache( sv, map, name => Mod_FindName( name ) );
+	sv.state = ss_loading; SV_SetState( sv, svs, pr_global_struct ); SV_ClearWorld();
+	installServerCallbacks( { SV_Move, SV_TestEntityPosition, SV_LinkEdict, SV_PointContents, PR_ExecuteProgram } );
+	Hexen2_SpawnEntities( sv, map, 392, PR_AllocEdicts );
+	const start = sv.edicts.find( ent => ent && ! ent.free && PR_GetString( ent.v.classname ) === 'info_player_start' );
+	const player = sv.edicts[ 1 ];
+	const client = { name: 'anim', active: true, spawned: true, edict: player, spawn_parms: new Array( 16 ).fill( 0 ), message: sv.signon, cmd: { viewangles: [ 0, 0, 0 ] } };
+	svs.clients[ 0 ] = client;
+	check( Hexen2_SpawnPlayer( { sv, client, player, gameId: 'hexen2', classId: 'paladin', origin: start.v.origin } ).ok, 'the Paladin spawned' );
+	sv.active = true; sv.state = ss_active; SV_SetFrametime( 0.1 );
+	return { sv, player, frames: count => { for ( let i = 0; i < count; i ++ ) { SV_Physics(); pr_global_struct.time = sv.time; } } };
+
+}
+
+Deno.test( 'holding attack advances the first-person weapon frames', () => {
+
+	const game = boot();
+	if ( game === null ) { console.log( 'SKIP: the supplied Hexen II installation is not present' ); return; }
+	const { player, frames } = game;
