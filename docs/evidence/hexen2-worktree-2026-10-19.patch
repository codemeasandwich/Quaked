+	same( Hexen2_MenuMove( 0, -1, 8 ), 0, 'up at the top clamps' );
+	same( Hexen2_MenuMove( 7, 1, 8 ), 7, 'down at the bottom clamps' );
+	same( Hexen2_MenuMove( 2, 1, 8 ), 3, 'down moves' );
+	same( Hexen2_MenuMove( 2, -1, 8 ), 1, 'up moves' );
