+import { PR_LoadProgs, PR_AllocEdicts } from '../src/engine/progs/pr_edict.js';
+import { PR_SetSV, PR_SetSVS, PR_GetString, pr_global_struct, svs } from '../src/engine/progs/progs.js';
+import { sv as serverSv, ss_loading, ss_active, SIGNON_SIZE } from '../src/engine/server/server.js';
+import { PR_ExecuteProgram, PR_LastRunError } from '../src/engine/progs/pr_exec.js';
+import { Hexen2_SeedPrecache, Hexen2_SpawnEntities, Hexen2_SpawnPlayer } from '../src/engine/progs/hexen2_boot.js';
+import { Hexen2_ReadHud, Hexen2_ArmourTotal } from '../src/engine/client/hexen2_hud.js';
+import { Hexen2_ArtifactCounts } from '../src/engine/client/hexen2_inventory.js';
+import { installServerCallbacks } from './helpers/hexen2_server_setup.mjs';
+import '../src/engine/progs/hexen2_world_cmds.js';
+import '../src/engine/progs/hexen2_precache_cmds.js';
+import '../src/engine/progs/hexen2_server_cmds.js';
+
+const check = ( v, m ) => { if ( ! v ) throw new Error( m ); };
+const HEXEN = '/Users/bri/quaked/Hexen 2/data1';
+
+function boot( classId = 'paladin' ) {
+
+	if ( ! existsSync( HEXEN + '/pak1.pak' ) ) return null;
+	for ( const name of [ 'pak0.pak', 'pak1.pak' ] ) { const raw = readFileSync( HEXEN + '/' + name ); pak.COM_AddPack( pak.COM_LoadPackFile( 'h2-' + name, raw.buffer.slice( raw.byteOffset, raw.byteOffset + raw.length ) ) ); }
+	const palette = pak.COM_FindFile( 'gfx/palette.lmp' ).data;
+	VID_SetPalette( palette.buffer.slice( palette.byteOffset, palette.byteOffset + palette.byteLength ) );
+	Mod_Init();
+	const progsBytes = readFileSync( HEXEN + '/progs.dat' );
+	PR_LoadProgs( progsBytes.buffer.slice( progsBytes.byteOffset, progsBytes.byteOffset + progsBytes.byteLength ) );
+	Mod_SetHexenHullLayout( true );
+	const map = new model_t(); map.name = 'maps/demo1.bsp'; set_loadmodel( map );
+	const bsp = pak.COM_FindFile( 'maps/demo1.bsp' ).data;
+	Mod_LoadBrushModel( map, bsp.buffer.slice( bsp.byteOffset, bsp.byteOffset + bsp.byteLength ) );
+	Mod_SetHexenHullLayout( false );
+
+	const sv = serverSv;
+	PR_SetSV( sv ); PR_SetSVS( { maxclients: 1, clients: [], active: true } );
+	sv.time = 0.1; sv.signon.data = sv.signon_buf; sv.signon.maxsize = SIGNON_SIZE; sv.worldmodel = map;
+	Hexen2_SeedPrecache( sv, map, name => Mod_FindName( name ) );
+	sv.state = ss_loading;
+	SV_SetState( sv, svs, pr_global_struct );
+	SV_ClearWorld();
+	installServerCallbacks( { SV_Move, SV_TestEntityPosition, SV_LinkEdict, SV_PointContents, PR_ExecuteProgram } );
+	Hexen2_SpawnEntities( sv, map, 392, PR_AllocEdicts );
+	const start = sv.edicts.find( ent => ent && ! ent.free && PR_GetString( ent.v.classname ) === 'info_player_start' );
+	const player = sv.edicts[ 1 ];
+	const client = { name: 'rpg', active: true, spawned: true, edict: player, spawn_parms: new Array( 16 ).fill( 0 ), message: sv.signon, cmd: { viewangles: [ 0, 0, 0 ] } };
+	svs.clients[ 0 ] = client;
+	check( Hexen2_SpawnPlayer( { sv, client, player, gameId: 'hexen2', classId, origin: start.v.origin } ).ok, 'the ' + classId + ' spawned' );
+	sv.active = true; sv.state = ss_active; SV_SetFrametime( 0.1 );
+	const frames = ( count = 1 ) => { for ( let i = 0; i < count; i ++ ) { SV_Physics(); pr_global_struct.time = sv.time; } };
+	return { sv, player, client, frames };
+
+}
+
+Deno.test( 'armour, an artifact and a weapon pick up on demo1', () => {
+
+	const game = boot();
+	if ( game === null ) { console.log( 'SKIP: the supplied Hexen II installation is not present' ); return; }
+	const { sv, player, frames } = game;
+	// let the level's items run PlaceItem (solid trigger) before moving them onto the player
+	frames( 5 );
+	const pickup = classname => {
+
+		const item = sv.edicts.find( ent => ent && ! ent.free && PR_GetString( ent.v.classname ) === classname );
+		check( item !== undefined, `demo1 spawned a ${classname}` );
+		item.v.origin = [ player.v.origin[ 0 ], player.v.origin[ 1 ], player.v.origin[ 2 ] ];
+		SV_LinkEdict( item, true );
+		frames( 3 );
+		return item;
+
+	};
+
+	for ( const [ classname, field ] of [ [ 'item_armor_amulet', 'armor_amulet' ], [ 'item_armor_bracer', 'armor_bracer' ],
+		[ 'item_armor_breastplate', 'armor_breastplate' ], [ 'item_armor_helmet', 'armor_helmet' ] ] ) {
+
+		pickup( classname );
+		check( ( player.v[ field ] | 0 ) > 0, `${field} was picked up: ${player.v[ field ] | 0}` );
+
+	}
+	const hud = Hexen2_ReadHud( player );
+	check( Hexen2_ArmourTotal( hud ) > 0, 'the HUD armour total follows the pickups: ' + Hexen2_ArmourTotal( hud ) );
+
+	pickup( 'art_torch' );
+	check( ( player.v.cnt_torch | 0 ) > 0, 'the torch count follows the pickup: ' + ( player.v.cnt_torch | 0 ) );
+	check( Hexen2_ArtifactCounts( player )[ 0 ] > 0, 'the inventory reads the torch count' );
+
+	const itemsBefore = player.v.items | 0;
+	pickup( 'wp_weapon2' );
+	check( ( player.v.items | 0 ) !== itemsBefore, `the weapon pickup changed items: ${itemsBefore} -> ${player.v.items | 0}` );
+
+} );
+
+Deno.test( 'a kill awards experience and advances the class level', () => {
+
+	const game = boot();
+	if ( game === null ) { console.log( 'SKIP: the supplied Hexen II installation is not present' ); return; }
+	const { sv, player, frames } = game;
+	player.v.experience = 944; // just below the Paladin level-2 threshold (945)
+	const levelBefore = player.v.level | 0, maxHealthBefore = player.v.max_health, maxManaBefore = player.v.max_mana;
+	const monster = sv.edicts.find( ent => ent && ! ent.free && /^monster_/.test( PR_GetString( ent.v.classname ) ) );
+	check( monster !== undefined, 'the level spawned a monster' );
+	monster.v.origin = [ player.v.origin[ 0 ] + 64, player.v.origin[ 1 ], player.v.origin[ 2 ] ];
+	monster.v.movetype = 0; monster.v.health = 1;
+	SV_LinkEdict( monster, true );
+	player.v.angles = [ 0, 0, 0 ]; player.v.v_angle = [ 0, 0, 0 ];
+	player.v.impulse = 1; frames( 1 ); player.v.impulse = 0; player.v.button0 = 1;
+	let error = null;
+	try { frames( 30 ); } catch ( e ) { error = e; }
+	player.v.button0 = 0;
+	check( error === null, 'the kill frames ran: ' + ( error ? error.message + ' [' + PR_LastRunError() + ']' : '' ) );
+	check( ( player.v.experience | 0 ) > 944, 'experience rose on the kill: ' + ( player.v.experience | 0 ) );
+	check( ( player.v.level | 0 ) > levelBefore, `the kill advanced the level: ${levelBefore} -> ${player.v.level | 0}` );
+	check( player.v.max_health > maxHealthBefore, `max health grew with the level: ${maxHealthBefore} -> ${player.v.max_health}` );
+	check( player.v.max_mana > maxManaBefore, `max mana grew with the level: ${maxManaBefore} -> ${player.v.max_mana}` );
+
+} );
diff --git a/tests/hexen2_save_test.js b/tests/hexen2_save_test.js
new file mode 100644
index 00000000..a90d6309
--- /dev/null
+++ b/tests/hexen2_save_test.js
@@ -0,0 +1,110 @@
+// The version-1 Hexen II single-session save record and its persistence boundary: a native player snapshot validates,
+// applies back to a live player, and refuses corrupted/lookalike records; the memory and localStorage stores round-trip
+// one record without touching the Quake save keys.
+import { HEXEN2_SAVE_SCHEMA, HEXEN2_SAVE_PLAYER_FIELDS, Hexen2_BuildSaveBundle, Hexen2_ValidateSaveBundle,
+	Hexen2_ApplySaveBundle, Hexen2_CapturePlayer, Hexen2_SaveStore, Hexen2_NormalizeMapName, Hexen2_TransitionUrl, Hexen2_HubStore } from '../src/engine/common/hexen2_save.js';
+
+const check = ( v, m ) => { if ( ! v ) throw new Error( m ); }, same = ( a, b, m ) => check( a === b, `${m}: ${a} != ${b}` );
+function player() {
+
+	const v = { health: 75, max_health: 85, bluemana: 20, greenmana: 5, max_mana: 95, level: 2, experience: 1000,
+		strength: 12, intelligence: 14, wisdom: 11, dexterity: 13, armor_amulet: 20, items: 7, weapon: 1,
+		current_weapon: 1, weaponframe: 4, cnt_torch: 2, puzzle_inv1: 123, ring_flight: 1,
+		origin: [ 10, 20, 30 ], angles: [ 0, 90, 0 ], velocity: [ 1, 2, 3 ], v_angle: [ 0, 90, 0 ] };
+	for ( const name of HEXEN2_SAVE_PLAYER_FIELDS ) if ( !( name in v ) ) v[ name ] = 0;
+	return { v };
+
+}
+
+Deno.test( 'a native player snapshot builds, validates and applies back', () => {
+
+	const live = player(), bundle = Hexen2_BuildSaveBundle( { gameId: 'hexen2', classId: 'paladin', skill: 1, level: 'demo1', player: live, time: 12.5 } );
+	same( bundle.schema, HEXEN2_SAVE_SCHEMA, 'schema' );
+	same( bundle.kind, 'hexen2-single-session', 'kind' );
+	same( bundle.identity.level, 'demo1', 'level' );
+	same( bundle.player.health, 75, 'health' );
+	same( JSON.stringify( bundle.vectors.origin ), JSON.stringify( [ 10, 20, 30 ] ), 'origin' );
+	same( Hexen2_ValidateSaveBundle( bundle ).ok, true, 'the record validates' );
+
+	const target = player();
+	target.v.health = 1; target.v.origin = [ 0, 0, 0 ]; target.v.cnt_torch = 0;
+	const applied = Hexen2_ApplySaveBundle( bundle, target );
+	check( applied.ok, applied.reason );
+	same( target.v.health, 75, 'health restored' );
+	same( JSON.stringify( target.v.origin ), JSON.stringify( [ 10, 20, 30 ] ), 'origin restored' );
+	same( target.v.cnt_torch, 2, 'artifact count restored' );
+	same( target.v.puzzle_inv1, 123, 'puzzle slot restored' );
+	const transition = player(); transition.v.origin = [ 0, 0, 0 ]; Hexen2_ApplySaveBundle( bundle, transition, { vectors: false } );
+	same( JSON.stringify( transition.v.origin ), JSON.stringify( [ 0, 0, 0 ] ), 'a level transition keeps the new map start' );
+	same( transition.v.health, 75, 'a level transition still restores the native fields' );
+
+	same( Hexen2_NormalizeMapName( 'demo2' ), 'maps/demo2.bsp', 'a bare map name' );
+	same( Hexen2_NormalizeMapName( 'maps/ruins.bsp' ), 'maps/ruins.bsp', 'an already-normalised path' );
+	same( Hexen2_NormalizeMapName( '' ), '', 'an empty map is refused' );
+	const url = Hexen2_TransitionUrl( { pathname: '/index.html', gameId: 'hexen2', classId: 'crusader', skill: 2, map: 'ruins', spot: 'start' } );
+	check( url.startsWith( '/index.html?' ) && /autostart=1/.test( url ) && /class=crusader/.test( url ) && /map=maps%2Fruins.bsp/.test( url ), 'the transition URL: ' + url );
+	const hubBundle = Hexen2_BuildSaveBundle( { gameId: 'hexen2', classId: 'paladin', skill: 1, level: 'maps/demo1.bsp', player: live,
+		hub: { levels: { 'maps/demo1.bsp': { health: 75 } }, worlds: { 'maps/demo1.bsp': { schema: 1, level: 'maps/demo1.bsp' } } } } );
+	same( Hexen2_ValidateSaveBundle( hubBundle ).ok, true, 'a hub save validates' );
+	same( Object.keys( hubBundle.hub.worlds ).length, 1, 'the hub world is recorded' );
+	const badHub = structuredClone( hubBundle ); badHub.hub.levels = null;
+	same( Hexen2_ValidateSaveBundle( badHub ).ok, false, 'a malformed hub is refused' );
+	const captured = Hexen2_CapturePlayer( live );
+	same( Object.keys( captured.fields ).length, HEXEN2_SAVE_PLAYER_FIELDS.length, 'every field captured' );
+
+} );
+
+Deno.test( 'malformed and lookalike save records are refused before any live field is written', () => {
+
+	const bundle = Hexen2_BuildSaveBundle( { gameId: 'hexen2', classId: 'paladin', skill: 1, level: 'demo1', player: player(), view: { angles: [ 0, 0, 0 ], time: 1 } } );
+	const refuse = ( mutate, name ) => { const copy = structuredClone( bundle ); mutate( copy ); const r = Hexen2_ValidateSaveBundle( copy ); check( !r.ok, name + ' should be refused' ); };
+	refuse( copy => { copy.schema = HEXEN2_SAVE_SCHEMA + 1; }, 'a future schema' );
+	refuse( copy => { copy.kind = 'quake'; }, 'a Quake save' );
+	refuse( copy => { copy.identity.level = ''; }, 'an empty level' );
+	refuse( copy => { copy.identity.skill = 4; }, 'an out-of-range skill' );
+	refuse( copy => { copy.player.health = null; }, 'a non-finite field' );
+	refuse( copy => { copy.vectors.origin = [ 0, 0 ]; }, 'a short vector' );
+	refuse( copy => { copy.time = 'soon'; }, 'a non-finite time' );
+	refuse( copy => { copy.view.angles = [ 0, 0 ]; }, 'a short client view' );
+	const target = player(); target.v.health = 3;
+	const bad = structuredClone( bundle ); bad.player.health = '70';
+	same( Hexen2_ApplySaveBundle( bad, target ).ok, false, 'apply refuses an invalid record' );
+	same( target.v.health, 3, 'the invalid apply wrote nothing' );
+
+} );
+
+Deno.test( 'the memory and localStorage stores round-trip a record without Quake keys', async () => {
+
+	const memory = Hexen2_SaveStore( { indexedDB: null, localStorage: null } );
+	same( memory.kind, 'memory', 'memory fallback' );
+	await memory.put( 'quicksave', { a: 1 } );
+	same( ( await memory.get( 'quicksave' ) ).a, 1, 'memory get' );
+	same( ( await memory.list() ).join( ',' ), 'quicksave', 'memory list' );
+	await memory.remove( 'quicksave' );
+	same( await memory.get( 'quicksave' ), null, 'memory remove' );
+
+	const data = new Map();
+	const storage = { get length() { return data.size; }, key: i => [ ...data.keys() ][ i ] ?? null,
+		getItem: key => data.get( key ) ?? null, setItem: ( key, value ) => data.set( key, value ), removeItem: key => data.delete( key ) };
+	storage.setItem( 'quake_save_1', 'legacy' );
+	const local = Hexen2_SaveStore( { indexedDB: null, localStorage: storage } );
+	same( local.kind, 'localstorage', 'localStorage fallback' );
+	await local.put( 'quicksave', { health: 70 } );
+	same( ( await local.get( 'quicksave' ) ).health, 70, 'localStorage get' );
+	check( storage.getItem( 'quake_save_1' ) === 'legacy', 'the legacy Quake key is untouched' );
+	await local.remove( 'quicksave' );
+	same( await local.get( 'quicksave' ), null, 'localStorage remove' );
+
+	const hub = Hexen2_HubStore( { localStorage: storage } );
+	hub.put( 'maps/demo1.bsp', { level: 'maps/demo1.bsp' } );
+	hub.put( 'demo2', { level: 'maps/demo2.bsp' } );
+	same( hub.get( 'maps/demo2.bsp' ).level, 'maps/demo2.bsp', 'hub snapshots are normalised' );
+	same( Object.keys( hub.all() ).length, 2, 'the hub has both visited levels' );
+	hub.putWorld( 'maps/demo1.bsp', { schema: 1, level: 'maps/demo1.bsp' } );
+	same( hub.getWorld( 'demo1' ).level, 'maps/demo1.bsp', 'the hub world snapshot is normalised' );
+	same( Object.keys( hub.allWorlds() ).length, 1, 'the hub world list' );
+	hub.clear();
+	same( Object.keys( hub.all() ).length, 0, 'the hub clears' );
+	same( Object.keys( hub.allWorlds() ).length, 0, 'the hub clears worlds' );
+
+} );
diff --git a/tests/hexen2_startspot_test.js b/tests/hexen2_startspot_test.js
new file mode 100644
index 00000000..6ed44807
--- /dev/null
+++ b/tests/hexen2_startspot_test.js
@@ -0,0 +1,45 @@
+// Hexen II start spots: a triggered changelevel passes a targetname (demo1's starts are `demo2`/`demo3`); the mounted
+// session must set the native `startspot` and place the player at that start, not the first info_player_start.
+import { existsSync, readFileSync } from 'node:fs';
+import * as pak from '../src/engine/common/pak.js';
+import { VID_SetPalette } from '../src/engine/render/vid.js';
+import { Mod_Init } from '../src/engine/render/gl_model.js';
+import { model_t } from '../src/engine/render/gl_model_types.js';
+import { set_loadmodel } from '../src/engine/render/gl_model_common.js';
+import { Mod_LoadBrushModel } from '../src/engine/render/gl_model_bsp.js';
+import { sv as serverSv, SIGNON_SIZE } from '../src/engine/server/server.js';
+import { PR_ExecuteProgram } from '../src/engine/progs/pr_exec.js';
+import { PR_GetString } from '../src/engine/progs/progs.js';
+import { Hexen2_MountLevel } from '../src/engine/progs/hexen2_mount.js';
+import { installServerCallbacks } from './helpers/hexen2_server_setup.mjs';
+import '../src/engine/progs/hexen2_world_cmds.js';
+import '../src/engine/progs/hexen2_precache_cmds.js';
+import '../src/engine/progs/hexen2_server_cmds.js';
+
+const check = ( v, m ) => { if ( ! v ) throw new Error( m ); }, near = ( a, b, m ) => check( Math.abs( a - b ) <= 1, `${m}: ${a} != ${b}` );
+const HEXEN = '/Users/bri/quaked/Hexen 2/data1';
+
+Deno.test( 'a changelevel start spot places the player at its targetname', () => {
+
+	if ( ! existsSync( HEXEN + '/pak1.pak' ) ) { console.log( 'SKIP: the supplied Hexen II installation is not present' ); return; }
+	for ( const name of [ 'pak0.pak', 'pak1.pak' ] ) { const raw = readFileSync( HEXEN + '/' + name ); pak.COM_AddPack( pak.COM_LoadPackFile( 'h2-' + name, raw.buffer.slice( raw.byteOffset, raw.byteOffset + raw.length ) ) ); }
+	const palette = pak.COM_FindFile( 'gfx/palette.lmp' ).data;
+	VID_SetPalette( palette.buffer.slice( palette.byteOffset, palette.byteOffset + palette.byteLength ) );
+	Mod_Init();
+	const sv = serverSv;
+	sv.signon.data = sv.signon_buf; sv.signon.maxsize = SIGNON_SIZE;
+	const client = { name: 'spot', active: true, spawned: true, spawn_parms: new Array( 16 ).fill( 0 ), message: sv.signon, cmd: { viewangles: [ 0, 0, 0 ] } };
+	const svs = { maxclients: 1, clients: [ client ], active: true };
+	const mounted = Hexen2_MountLevel( {
+		entry: { id: 'hexen2', kind: 'hexen2', folder: 'games/Hexen 2/data1', playable: true },
+		classId: 'paladin', skill: 1, spot: 'demo2', client, sv, svs,
+		readFile: name => existsSync( HEXEN + '/' + name ) ? new Uint8Array( readFileSync( HEXEN + '/' + name ) ) : null,
+		loadMap: name => { const map = new model_t(); map.name = name; set_loadmodel( map ); const found = pak.COM_FindFile( name ); Mod_LoadBrushModel( map, found.data.buffer.slice( found.data.byteOffset, found.data.byteOffset + found.size ) ); return map; },
+		installCallbacks: callbacks => installServerCallbacks( callbacks )
+	} );
+	check( mounted.ok, mounted.reason );
+	near( mounted.player.v.origin[ 0 ], -1944, 'the demo2 start x' );
+	near( mounted.player.v.origin[ 1 ], 2448, 'the demo2 start y' );
+	check( mounted.player.v.origin[ 2 ] > -560 && mounted.player.v.origin[ 2 ] <= -512, 'the player dropped onto the demo2 floor: ' + mounted.player.v.origin[ 2 ] );
+
+} );
