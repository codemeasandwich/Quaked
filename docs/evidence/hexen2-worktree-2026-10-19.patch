+	const client = { name: 'eidolon', active: true, spawned: true, spawn_parms: new Array( 16 ).fill( 0 ), message: sv.signon, cmd: { viewangles: [ 0, 0, 0 ] } };
+	const mounted = Hexen2_MountLevel( {
