  "material": {
    "verdict": "PASS both actual tiers and retained raw/master",
    "interpretation": "Very dark blue-black stained/weathered timber blocks, horizontal fibres with irregular pores, restrained abrasion and cool worn rims. Native material certainty remains unresolved; this is the reviewed plausible interpretation.",
    "observation": "Both256and512 preserve coherent horizontal fibre paths and irregular wood wear rather than random granules or sharpened native pixels. Deep narrow gaps keep the two-column stagger readable. No new hardware, dominant ornament, invented extra blocks or synthetic noise overlay identified."
  },
  "nativeDistance": {
    "verdict": "PASS representative colour/forms/style/scale at both BOX distances",
    "method": "Both native64 and decodedMid256/High512 BOX to32 and16; unaltered tiny pixels retained, nearest8x display only.",
    "observation": "Cool near-black hierarchy, two equal-width columns and staggered horizontal joints remain. Enhanced faces gain horizontally coherent timber structure; exact coarse face mottling and exact pixel colours are not claimed. Native has diffuse cool rims; replacement rims remain subordinate to the gaps."
  },
  "repeat": {
    "verdict": "PASS offline actual256and512 repeat/corner inspection",
    "observation": "Central/wrapped X joints remain intended vertical gaps. LeftY0/32/64 and rightY16/48 joints preserve source phase. Right face crossesYwrap with a narrow fibre/value discontinuity that reads as weathered grain, not an open trough, paired end bevel, separate terminal strip, or new structural butt. Inspected1:1 2x2and corner crosses and supplemental4xnearest colour/height displays. No pixel-identical grain continuity claim.",
    "residual": "This visual decision must be checked in actual oblique/flat and relief GPU poses; offline depth samples alone do not waive a later visible seam."
  },
  "relief": {
    "verdict": "PASS selected physical ordering plus offline opposed-light inspection",
    "observation": "Four predeclared actual gap cores and eight neighbouring face locations were visually confirmed against colour before using their fixed scalar samples. Both tiers preserve lower gaps and rough timber faces. XYZ and opposed .65/.35 lights show consistent direction reversal with no lighting-baked fake gap at rightYwrap. Rough faces are nonplanar; broad full-range height does not establish calibrated real-world displacement.",
    "fixedWitnessesMoved": false,
    "profileOrNormalStrengthChanged": false,
    "comparisons": 16,
    "minimumFaceMinusJointMean3x3": 0.069281045751634,
    "minimumFaceMinusJointCentre": 0.07450980392156863
  },
