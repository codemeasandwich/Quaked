{
	"name": "@three-quake/server",
	"version": "1.0.0",
	"exports": "./game_server.js",
	"tasks": {
		"room": "deno run --allow-net --allow-read --unstable-net --config ../deno.json game_server.js",
		"lobby": "deno run --allow-net --allow-read --allow-run --unstable-net --config ../deno.json lobby_server.js"
	},
	"compilerOptions": {
		"lib": ["deno.window"],
		"strict": true
	},
	"imports": {
		"@std/path": "jsr:@std/path@^1",
		"three": "https://cdn.jsdelivr.net/npm/three@0.183.0/build/three.module.js"
	}
}
